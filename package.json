{
    "name": "app-planner-editor",
    "version": "1.0.0",
    "description": "Printable planner editor that runs entirely in the browser: four views, 16 themes, 11 typefaces, public holidays, PDF and JPG export.",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "engines": {
        "node": "^22.13.0 || >=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write \"**/*.{js,ts,css,html,json}\"",
        "format:check": "prettier --check \"**/*.{js,ts,css,html,json}\"",
        "test": "playwright test"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "6.5.2",
        "html-to-image": "1.11.11",
        "jspdf": "4.2.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.11.1",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.58.2",
        "@types/node": "24.13.3",
        "eslint": "10.0.0",
        "globals": "17.3.0",
        "prettier": "3.8.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.57.2",
        "vite": "7.3.7"
    }
}
